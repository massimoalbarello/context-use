{
  "name": "@repo/backend",
  "type": "module",
  "private": true,
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    "./record": "./src/models/records/model.ts",
    "./retrieval": "./src/models/hypermedia-retrieval/model.ts",
    "./asset": "./src/models/assets/model.ts",
    "./entity": "./src/models/entities/model.ts",
    "./mcp-client-authorization": "./src/models/mcp-client-authorizations/model.ts",
    "./page": "./src/models/knowledge-pages/model.ts",
    "./runtime-config": "./src/lib/runtime-config.ts",
    "./sync": "./src/models/syncs/model.ts",
    "./temporal-coverage": "./src/models/knowledge-pages/temporal-coverage.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "bun run scripts/build.ts",
    "update:delivery-contract": "bun run scripts/update-record-delivery-contract.ts",
    "generate:delivery-contract": "bun run scripts/generate-record-delivery-contract.ts",
    "check:delivery-contract": "bun run scripts/generate-record-delivery-contract.ts --check",
    "generate:queries": "bun bun-sqlgen generate 'src/repositories/**/*.ts' --migrations src/db/migrations",
    "check:queries": "bun run generate:queries --check",
    "check:types": "bun run check:queries && bun run check:delivery-contract && bun run --bun tsc -b",
    "test": "bun test --pass-with-no-tests"
  },
  "dependencies": {
    "@better-auth/cimd": "^1.7.2",
    "@better-auth/core": "^1.7.2",
    "@better-auth/mcp": "^1.7.2",
    "@better-auth/passkey": "catalog:",
    "@elysiajs/openapi": "^1.4.15",
    "@ilbertt/better-auth-bun-sql": "^0.4.0",
    "@ilbertt/bun-sqlgen": "^0.5.1",
    "@modelcontextprotocol/server": "^2",
    "better-auth": "catalog:",
    "canonicalize": "^5.0.0",
    "elysia": "^1.4.30",
    "file-type": "^22.0.2",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-to-string": "^4.0.0",
    "strip-markdown": "^6.0.0",
    "unist-util-visit": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2",
    "@repo/typescript-config": "workspace:*",
    "@types/mdast": "^4.0.0",
    "json-schema-to-typescript": "^16.0.0",
    "json-schema-to-zod": "^2.8.1",
    "openapi-types": "^12.1.3",
    "typescript": "catalog:",
    "yaml": "^2.9.0"
  }
}
