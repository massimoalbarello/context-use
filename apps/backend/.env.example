# Optional: falls back to https://$NIBRUN_HOSTNAME on nibrun, else Vite's local public origin
BASE_URL=http://localhost:5173
DATA_FOLDER=./data
# Optional: overrides the auth secret generated and stored inside DATA_FOLDER
# BETTER_AUTH_SECRET="..."

# Open-connector setup command only: the ID names this external service inside Context Use.
# OPEN_CONNECTOR_INTEGRATION_ID=personal-open-connector
# OPEN_CONNECTOR_OWNER_ID=context-use-owner
# A separate delivery API key is generated per ID inside DATA_FOLDER when this override is omitted.
# Set OPEN_CONNECTOR_DELIVERY_API_KEY only through a server-side secret store when supplying it.
# OPEN_CONNECTOR_BASE_URL=http://localhost:8787
# OPEN_CONNECTOR_CALLBACK_URL=https://context-use.example/api/integrations/open-connector/records
# Set OPEN_CONNECTOR_ADMIN_TOKEN only in the setup command's server-side environment.
