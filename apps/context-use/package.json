{
  "name": "@repo/context-use",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --no-orphans --parallel dev:server dev:client",
    "dev:server": "bun run scripts/dev.ts",
    "dev:client": "bun --bun vite --config frontend/vite.config.ts",
    "build:instance": "bun run scripts/build-instance.ts",
    "build:demo": "bun run scripts/build-demo.ts",
    "build:client": "bun --bun vite build --config frontend/vite.config.ts",
    "build:demo:client": "bun --bun vite build --config demo/vite.config.ts",
    "build:faces": "bun run backend/scripts/build-faces.ts",
    "build:faces:host": "bun run backend/scripts/build-faces.ts --host",
    "deploy:instance": "bun run scripts/deploy-instance.ts",
    "deploy:demo": "bun run scripts/deploy-demo.ts",
    "generate:queries": "bun --cwd backend bun-sqlgen generate 'src/repositories/**/*.ts' --migrations src/db/migrations",
    "check:queries": "bun run generate:queries --check",
    "check:types": "bun run check:queries && bun run --bun tsc -b",
    "test": "bun run --sequential test:backend test:frontend test:demo test:build",
    "test:backend": "bun test --cwd backend",
    "test:frontend": "bun test --cwd frontend",
    "test:demo": "bun test ./demo/test/app.test.ts && bun test --cwd demo/frontend --preload ../test/dom.ts",
    "test:build": "bun test ./test/dev.test.ts ./test/build-targets.test.ts",
    "test:binary:instance": "bun test ./test/binary-instance.test.ts",
    "test:binary:demo": "bun test ./demo/test/binary.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@better-auth/cimd": "^1.7.2",
    "@better-auth/core": "^1.7.2",
    "@better-auth/mcp": "^1.7.2",
    "@better-auth/oauth-provider": "^1.7.2",
    "@better-auth/passkey": "catalog:",
    "@context-use/open-sync": "0.3.0",
    "@context-use/openclaw-memory": "workspace:*",
    "@elysiajs/eden": "^1.4.9",
    "@elysiajs/openapi": "^1.4.15",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@ilbertt/better-auth-bun-sql": "^0.4.0",
    "@ilbertt/bun-sqlgen": "^0.5.1",
    "@modelcontextprotocol/server": "^2",
    "@ncdai/react-wheel-picker": "^1.2.3",
    "@repo/ui": "workspace:*",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "better-auth": "catalog:",
    "class-variance-authority": "^0.7.1",
    "diff": "^9.0.0",
    "elysia": "^1.4.30",
    "file-type": "^22.0.2",
    "get-stream": "^9.0.1",
    "lucide-react": "^1.37.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-to-markdown": "^2.1.2",
    "mdast-util-to-string": "^4.0.0",
    "negotiator": "^1.1.0",
    "papaparse": "^5.7.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-pdf": "^11.0.0",
    "strip-markdown": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "unist-util-visit": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.0",
    "@modelcontextprotocol/client": "^2",
    "@octokit/graphql-schema": "15.26.1",
    "@repo/build-tools": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-generator": "1.167.33",
    "@tanstack/router-plugin": "^1.168.35",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/mdast": "^4.0.0",
    "@types/negotiator": "^0.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vgpu/wgsl": "0.4.1",
    "@vitejs/plugin-react": "^6.1.1",
    "openapi-types": "^12.1.3",
    "typescript": "catalog:",
    "vite": "^8.2.2",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "imports": {
    "#backend/*": "./backend/src/*",
    "#frontend/*": "./frontend/src/*"
  }
}
