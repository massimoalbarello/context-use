{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@repo/frontend#build": {
      "dependsOn": ["@repo/ui#build"],
      "outputs": ["dist/**"]
    },
    "@repo/backend#build": {
      "dependsOn": ["@repo/frontend#build", "@repo/backend#build:faces"],
      "env": ["BUILD_TARGET"],
      "outputs": ["dist/**", "public/**"]
    },
    "@repo/backend#build:faces": {
      "outputLogs": "new-only",
      "inputs": [
        "native/faces/**",
        "scripts/build-faces.ts",
        "scripts/shared/constants.ts"
      ],
      "env": ["BUILD_TARGET"],
      "outputs": [".cache/face-engine-linux/**", ".cache/face-engine-host/**"]
    },
    "check:types": {
      "dependsOn": ["^check:types"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "dev": {
      "cache": false,
      "env": [
        "BETTER_AUTH_SECRET",
        "DATA_FOLDER",
        "VITE_ISOLATED_CALENDAR_NOW"
      ],
      "persistent": true
    },
    "@repo/landing#build": {
      "env": ["BUILD_TARGET"],
      "outputs": ["dist/**"]
    }
  }
}
