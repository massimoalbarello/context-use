{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@repo/frontend#build": {
      "dependsOn": [],
      "outputs": ["dist/**"]
    },
    "@repo/backend#build": {
      "dependsOn": ["@repo/frontend#build"],
      "env": ["BUILD_TARGET"],
      "outputs": ["dist/**", "public/**"]
    },
    "check:types": {
      "dependsOn": ["^check:types"]
    },
    "check:queries": {
      "dependsOn": ["^check:queries"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "dev": {
      "cache": false,
      "env": ["BETTER_AUTH_SECRET", "DATA_FOLDER"],
      "persistent": true
    }
  }
}
