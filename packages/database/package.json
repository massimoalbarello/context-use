{
  "name": "@context-use/database",
  "version": "0.1.67",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./disposable-database": "./src/disposable-database.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "bootstrap": "bun src/template-command.ts apply default",
    "template": "bun src/template-command.ts",
    "initialize": "bun src/initialize.ts",
    "migrate": "bun src/migrate.ts",
    "reset:development": "bun src/reset-development.ts",
    "mark:disposable": "bun src/mark-disposable.ts",
    "test:roles": "bun test test/roles.integration.test.ts"
  },
  "dependencies": {
    "@context-use/shared": "workspace:*",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/pg": "8.20.0"
  }
}
