# Single loopback origin for a local installation. The cloud deployment splits
# the dashboard and asset hostnames; there is one origin here, so asset routes
# are folded in alongside the published pages.
{
	admin off
	auto_https off
}

:8080 {
	handle /api/auth/* {
		reverse_proxy auth:3002
	}
	handle /.well-known/oauth-authorization-server {
		reverse_proxy auth:3002
	}
	handle /.well-known/openid-configuration {
		reverse_proxy auth:3002
	}
	handle /.well-known/oauth-protected-resource* {
		reverse_proxy private-mcp:3003
	}
	handle /mcp {
		reverse_proxy private-mcp:3003
	}
	handle /api/mcp/* {
		reverse_proxy private-mcp:3003
	}
	handle /api/dashboard/* {
		reverse_proxy dashboard-edge:3007
	}
	handle /api/health {
		reverse_proxy dashboard-edge:3007
	}
	handle /app* {
		reverse_proxy dashboard-edge:3007
	}
	handle /assets/* {
		reverse_proxy dashboard-edge:3007
	}
	handle /p/* {
		reverse_proxy public-web:3005
	}
	handle /a/* {
		reverse_proxy public-web:3005
	}
	handle /public.css {
		reverse_proxy public-web:3005
	}
	handle /content.css {
		reverse_proxy public-web:3005
	}
	handle {
		reverse_proxy public-web:3005
	}
}
