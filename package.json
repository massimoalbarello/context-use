{
  "name": "bun-monorepo",
  "type": "module",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@better-auth/passkey": "^1.7.2",
      "better-auth": "^1.7.2",
      "typescript": "^7.0.2"
    }
  },
  "scripts": {
    "backend:dev": "bun --filter @repo/backend dev",
    "backend:build": "bun run --bun turbo build --filter=@repo/backend",
    "frontend:dev": "bun --filter @repo/frontend dev",
    "frontend:build": "bun run --bun turbo build --filter=@repo/frontend",
    "dev": "bun run --bun turbo dev --filter=@repo/backend --filter=@repo/frontend",
    "dev:isolated": "bun run scripts/dev-isolated.ts",
    "dev:isolated:seeded": "bun run scripts/dev-isolated.ts --seed",
    "deploy:nibrun": "bun run scripts/deploy-nibrun.ts",
    "build": "bun run --bun turbo build",
    "build:local": "BUILD_TARGET=host bun run --bun turbo build --filter=@repo/backend",
    "check:types": "bun run --bun turbo check:types",
    "check:codestyle": "bun run --bun biome check",
    "check:all": "bun run --parallel check:types check:codestyle",
    "check:commit-message": "bun run --bun commitlint",
    "test": "bun run --bun turbo test",
    "fix:codestyle": "bun run --bun biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/format": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@types/bun": "^1.4.0",
    "turbo": "^2.10.12",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": "1.4.0",
    "node": "please use bun"
  },
  "packageManager": "bun@1.4.0"
}
