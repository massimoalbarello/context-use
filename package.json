{
  "name": "bun-monorepo",
  "type": "module",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@better-auth/passkey": "^1.7.2",
      "better-auth": "^1.7.2",
      "typescript": "^7.0.2"
    }
  },
  "scripts": {
    "dev": "bun run --bun turbo dev --filter=@repo/context-use",
    "dev:isolated": "bun run scripts/dev-isolated.ts",
    "dev:isolated:seeded": "bun run scripts/dev-isolated.ts --seed",
    "build:instance": "bun run --bun turbo build:instance --filter=@repo/context-use",
    "build:demo": "bun run --bun turbo build:demo --filter=@repo/context-use",
    "build:landing": "bun run --bun turbo build --filter=@repo/landing",
    "deploy:instance": "bun --filter @repo/context-use deploy:instance",
    "deploy:demo": "bun --filter @repo/context-use deploy:demo",
    "deploy:landing": "bun --filter @repo/landing deploy",
    "check:types": "bun run --bun turbo check:types",
    "check:codestyle": "bun run --bun biome check",
    "check:frontend": "node node_modules/eslint/bin/eslint.js apps/context-use/frontend/src",
    "check:backend": "node apps/context-use/backend/scripts/check-boundaries.mjs",
    "check:all": "bun run --parallel check:types check:codestyle check:frontend check:backend",
    "check:commit-message": "bun run --bun commitlint",
    "test": "bun run --bun turbo test",
    "fix:codestyle": "bun run --bun biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/format": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@repo/browser-testing": "workspace:*",
    "@shadcn/lint": "0.1.0",
    "@tanstack/eslint-plugin-query": "5.103.0",
    "@types/bun": "^1.4.0",
    "@typescript-eslint/parser": "8.70.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "dependency-cruiser": "18.3.1",
    "eslint": "9.39.5",
    "turbo": "^2.10.12",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "engines": {
    "bun": "1.4.0",
    "node": ">=22.14.0"
  },
  "packageManager": "bun@1.4.0"
}
