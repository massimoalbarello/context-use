{
  "name": "context-use",
  "version": "0.1.75",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "kysely": "0.28.17",
    "nanoid": "3.3.18"
  },
  "scripts": {
    "dev": "bun run --filter '@context-use/*' dev",
    "dev:server": "bun --cwd apps/server dev",
    "dev:web": "bun --cwd apps/web dev",
    "local": "bun scripts/local-stack.ts",
    "eval": "bun scripts/eval.ts",
    "build": "bun run --filter '@context-use/*' build",
    "typecheck": "bun run --filter '@context-use/*' typecheck",
    "test": "bun test apps packages",
    "db:bootstrap": "bun apps/server/src/template-command.ts apply default",
    "db:initialize": "bun --cwd packages/database initialize",
    "db:migrate": "bun --cwd packages/database migrate",
    "db:test": "bun scripts/test-database.ts",
    "db:test:roles": "bun --cwd packages/database test:roles"
  },
  "devDependencies": {
    "@types/bun": "1.3.8",
    "typescript": "5.9.3",
    "zod": "4.4.3"
  }
}
