{
  "name": "context-use",
  "type": "module",
  "private": true,
  "workspaces": {
    "packages": [
      "frontend",
      "backend"
    ],
    "catalog": {
      "typescript": "^7.0.2"
    }
  },
  "scripts": {
    "backend": "bun --filter backend",
    "backend:dev": "bun backend dev",
    "backend:build": "bun backend build",
    "frontend": "bun --filter frontend",
    "frontend:dev": "bun frontend dev",
    "frontend:build": "bun frontend build",
    "dev": "bun run --parallel --no-orphans backend:dev frontend:dev",
    "build": "bun frontend:build && bun backend:build",
    "build:local": "BUILD_TARGET=host bun run build",
    "check:types": "bun --filter \"*\" check:types",
    "check:codestyle": "bun run --bun biome check",
    "check:all": "bun run --parallel check:types check:codestyle",
    "check:commit-message": "bun run --bun commitlint",
    "test": "bun test",
    "fix:codestyle": "bun run --bun biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/format": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@types/bun": "^1.4.0",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": "1.4.0",
    "node": "please use bun"
  },
  "packageManager": "bun@1.4.0"
}
